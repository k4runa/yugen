.claude

build/
_deps/
ui/node_modules/
ui/dist/

# heaptrack / profiler output
heaptrack.*.zst

# vendored discord social sdk (downloaded, not part of the source tree)
discord_social_sdk/

# makepkg works out of $startdir, and at the repo root its $srcdir would be
# ./src - where the c++ sources live. that is why the pkgbuild sits in a
# directory of its own, and these are what it leaves behind there.
packaging/aur/src/
packaging/aur/pkg/
packaging/aur/*.tar.gz

# appimage build output, and the tool that produces it
AppDir/
build-appimage/
*.AppImage
