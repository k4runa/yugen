{
  // ---- C++ : clangd LSP olarak, cpptools sadece debugger olarak ----
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",

  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build",
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=iwyu",
    "--all-scopes-completion",
    "--pch-storage=memory",
    "-j=4"
  ],
  "clangd.detectExtensionConflicts": false,
  "clangd.onConfigChanged": "restart",

  // ---- CMake ----
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureOnOpen": true,
  "cmake.generator": "Ninja",

  // ---- React/TS tarafi: kok degil ui/ ----
  "typescript.tsdk": "ui/node_modules/typescript/lib",
  "eslint.workingDirectories": [{ "directory": "ui", "changeProcessCWD": true }],

  "files.associations": { "*.h": "cpp", "*.hpp": "cpp" },
  "files.exclude": {
    "build/_deps": true,
    "CMakeFiles": true,
    "_deps": true,
    ".cache": true
  },
  "search.exclude": {
    "build": true,
    "_deps": true,
    "ui/node_modules": true,
    "ui/dist": true
  }
}
