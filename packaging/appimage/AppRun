#!/bin/sh
#
# yugen's AppImage entry point.
#
# The one thing this does beyond finding the binary is put the bundled yt-dlp
# and ffmpeg ahead of whatever the host has. services.cpp shells out to bare
# `yt-dlp`, so the lookup goes through PATH and the C++ side needs no change;
# yt-dlp finds ffmpeg the same way.
#
# WebKitGTK is deliberately not in here. It hardcodes the path to its helper
# processes at build time, so a bundled copy can only be reached by mounting it
# over that path, and the bundle would then have to match the host's GTK stack
# as well. It comes from the distro instead - see the README.

set -e

here=$(dirname "$(readlink -f "$0")")

export PATH="$here/usr/bin:$PATH"
export LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$here/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# an escape hatch for the machines where the gpu path is what breaks:
# YUGEN_SAFE_MODE=1 falls back to software compositing
if [ -n "${YUGEN_SAFE_MODE:-}" ]; then
    export WEBKIT_DISABLE_DMABUF_RENDERER=1
    export WEBKIT_DISABLE_COMPOSITING_MODE=1
fi

exec "$here/usr/bin/yugen" "$@"
